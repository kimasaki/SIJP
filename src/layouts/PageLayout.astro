---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
}
const { title, heading = title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="page"><div class="wrap">
    <h1>{heading}</h1>
    <slot />
  </div></article>
</BaseLayout>
