---
import { icons, type IconName } from '../data/icons';

interface Props {
  title: string;
  icon: IconName;
  href?: string;
}
const { title, icon, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href}>
  <svg class="card-icon" viewBox="0 -960 960 960" aria-hidden="true"><path d={icons[icon]} fill="currentColor" /></svg>
  <div class="card-body">
    <h3 set:html={title} />
    {href && <span class="more">Explore more →</span>}
  </div>
</Tag>
